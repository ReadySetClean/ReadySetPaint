</head>
<body class="font-sans text-gray-800">

  <!-- Navbar -->
  <nav class="bg-white shadow-md fixed top-0 w-full z-50">
    <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
      <h1 class="text-2xl font-bold text-orange-600">ReadySetPaint</h1>
      <div class="space-x-6 hidden md:flex">
        <a href="#about" class="hover:text-orange-600">About</a>
        <a href="#services" class="hover:text-orange-600">Services</a>
        <a href="#gallery" class="hover:text-orange-600">Gallery</a>
        <a href="#contact" class="hover:text-orange-600">Contact</a>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="h-screen bg-cover bg-center flex items-center justify-center text-center"
    style="background-image: url('https://images.unsplash.com/photo-1581093588401-22c9b6ac2d97?auto=format&fit=crop&w=1350&q=80');">
    <div class="bg-black bg-opacity-50 p-10 rounded-lg text-white">
      <h2 class="text-4xl md:text-5xl font-bold mb-4">Transform Your Space with ReadySetPaint</h2>
      <p class="text-lg mb-6">Professional Interior, Exterior, and Commercial Painting in Toronto & the GTA</p>
      <a href="#contact" class="bg-orange-600 hover:bg-orange-700 px-6 py-3 rounded-lg font-semibold">Get a Free Quote</a>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="py-16 bg-gray-50">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h3 class="text-3xl font-bold text-gray-800 mb-4">About ReadySetPaint</h3>
      <p class="text-lg text-gray-600 max-w-3xl mx-auto">
        At ReadySetPaint, we bring color, precision, and professionalism to every project. Whether it's your home,
        office, or commercial property, our experienced team ensures a flawless finish that lasts.
      </p>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="py-16">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h3 class="text-3xl font-bold text-gray-800 mb-8">Our Services</h3>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="p-6 bg-white rounded-2xl shadow hover:shadow-lg transition">
          <img src="https://images.unsplash.com/photo-1597008581458-09e5f9a6e386?auto=format&fit=crop&w=800&q=80" alt="Interior Painting" class="rounded-lg mb-4">
          <h4 class="text-xl font-semibold mb-2">Interior Painting</h4>
          <p class="text-gray-600">Transform your living or workspace with smooth, vibrant finishes that reflect your style.</p>
        </div>
        <div class="p-6 bg-white rounded-2xl shadow hover:shadow-lg transition">
          <img src="https://images.unsplash.com/photo-1605296867304-46d5465a13f1?auto=format&fit=crop&w=800&q=80" alt="Exterior Painting" class="rounded-lg mb-4">
          <h4 class="text-xl font-semibold mb-2">Exterior Painting</h4>
          <p class="text-gray-600">Enhance your property’s curb appeal with durable, weather-resistant coatings.</p>
        </div>
        <div class="p-6 bg-white rounded-2xl shadow hover:shadow-lg transition">
          <img src="https://images.unsplash.com/photo-1595433562696-a8b1cb8c310d?auto=format&fit=crop&w=800&q=80" alt="Commercial Painting" class="rounded-lg mb-4">
          <h4 class="text-xl font-semibold mb-2">Commercial Painting</h4>
          <p class="text-gray-600">Professional painting solutions for offices, retail, and industrial spaces.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Gallery -->
  <section id="gallery" class="py-16 bg-gray-50">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h3 class="text-3xl font-bold text-gray-800 mb-8">Our Work</h3>
      <div class="grid md:grid-cols-3 gap-6">
        <img src="https://images.unsplash.com/photo-1560448075-bb485b067938?auto=format&fit=crop&w=800&q=80" class="rounded-lg shadow" alt="">
        <img src="https://images.unsplash.com/photo-1598928506311-c55ded91a20f?auto=format&fit=crop&w=800&q=80" class="rounded-lg shadow" alt="">
        <img src="https://images.unsplash.com/photo-1581091215367-59ab6b05c1e9?auto=format&fit=crop&w=800&q=80" class="rounded-lg shadow" alt="">
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="py-16">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h3 class="text-3xl font-bold text-gray-800 mb-6">Get a Quote</h3>
      <p class="text-gray-600 mb-8">We’re ready to help you bring your vision to life. Get in touch today!</p>

      <form class="grid gap-4 max-w-md mx-auto">
        <input type="text" placeholder="Your Name" class="border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-orange-600">
        <input type="email" placeholder="Your Email" class="border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-orange-600">
        <textarea placeholder="Tell us about your project" rows="4" class="border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-orange-600"></textarea>
        <button type="submit" class="bg-orange-600 text-white font-semibold py-2 rounded-lg hover:bg-orange-700">Send Message</button>
      </form>

      <div class="mt-10 text-gray-700">
        <p><strong>Email:</strong> goreadysetclean@gmail.com</p>
        <p><strong>Phone:</strong> 647-809-6053</p>
        <p><strong>Service Area:</strong> Toronto & GTA</p>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-gray-900 text-gray-400 py-6 text-center">
    <p>© 2025 ReadySetPaint. All rights reserved.</p>
  </footer>

